- name: epy_block_0
  id: epy_block
  parameters:
    Fft_Len: '512'
    Previous_Freq: '0.0'
    Samp_Rate: '300000'
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, Fft_Len=512, Samp_Rate=300000, Previous_Freq=0.0):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Carrier\
      \ Offset Calculation',\n            in_sig=[np.float32],  # Receives the float\
      \ index from 'Short to Float'\n            out_sig=[np.int32]  # Outputs the\
      \ calculated frequency offset in Hz\n        )\n        self.Fft_Len = Fft_Len\n\
      \        self.Samp_Rate = Samp_Rate\n        self.Previous_Freq = Previous_Freq\n\
      \n    def work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        out = output_items[0]\n        \n        for i in range(len(in0)):\n\
      \            bin_index = in0[i]\n            \n            # Shift the FFT bins\
      \ so index 0 centers around 0 Hz (handling negative frequencies)\n         \
      \   if bin_index >= self.Fft_Len / 2:\n                bin_index -= self.Fft_Len\n\
      \            \n            # 1. Convert bin index to the multiplied frequency\
      \ domain\n            freq_in_multiplied_domain = (bin_index * self.Samp_Rate)\
      \ / self.Fft_Len\n            \n            # 2. Divide by 4 because the prior\
      \ x4 Multiply blocks magnified the error 4x\n            true_hardware_offset\
      \ = freq_in_multiplied_domain / 4.0\n            \n            out[i] = \u0131\
      nt(true_hardware_offset)\n            \n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Carrier Offset Calculation', 'blk', [('Fft_Len', '512'), ('Samp_Rate',
      '300000'), ('Previous_Freq', '0.0')], [('0', 'float', 1)], [('0', 'int', 1)],
      '', ['Fft_Len', 'Previous_Freq', 'Samp_Rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 348.0]
    rotation: 0
    state: true
